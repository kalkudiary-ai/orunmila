#!/bin/sh
# TURBO (LD109, layer 3): refuse any update to refs/heads/main, however git is
# invoked (porcelain, plumbing, a script, node -e). A TURBO session gets this
# folder as core.hooksPath through GIT_CONFIG_COUNT in its environment.
# A merge into main is a release and needs O (CLAUDE.md "How to work" 9).
[ "$1" = prepared ] || exit 0
while read -r old new ref; do
  if [ "$ref" = refs/heads/main ]; then
    echo "TURBO: refused an update to $ref ($old -> $new). A merge into main is a release and needs O: queue it with node scripts/turbo/plan.js queue." >&2
    exit 1
  fi
done
exit 0
