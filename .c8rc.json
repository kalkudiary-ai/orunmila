{
  "all": true,
  "include": [
    "src/**/*.js",
    "bin/**/*.js"
  ],
  "exclude": [
    "test/**",
    "coverage/**",
    "**/node_modules/**",
    "bin/bench.js",
    "bin/dashboard.js"
  ],
  "reporter": [
    "text",
    "html",
    "json-summary"
  ],
  "report-dir": "coverage",
  "temp-dir": "coverage/tmp",
  "check-coverage": true,
  "lines": 92,
  "statements": 92,
  "functions": 91,
  "branches": 81
}
